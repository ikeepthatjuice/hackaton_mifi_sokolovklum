# Пример окружения ТОЛЬКО машины сборки. Не загружается приложением автоматически.
# Замените абсолютные пути под свою установку; команды/версии см. docs/SETUP.md.
JAVA_HOME=/absolute/path/to/jdk-17
ANDROID_HOME=/absolute/path/to/android-sdk
# Ключей, токенов, сетевых inference URL и данных кейса здесь нет.
# Веса и runtime закреплены в models/manifest.json и engine/llm/dependencies.json.
# Не коммить свой .env или local.properties.
